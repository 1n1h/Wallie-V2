rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Users: public read (needed for admin dashboard), only owner can write
    match /users/{userId} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // Community posts: public read, authenticated create/update (only author)
    match /communityPosts/{postId} {
      allow read: if true;
      allow create: if request.auth != null;
      allow update: if request.auth != null;
    }
    match /communityPosts/{postId}/comments/{commentId} {
      allow read: if true;
      allow create: if request.auth != null;
    }

    // Conversations: only authenticated users
    match /conversations/{convId} {
      allow read, write: if request.auth != null;
    }
    match /conversations/{convId}/messages/{msgId} {
      allow read, write: if request.auth != null;
    }

    // Affiliates: public read (for code lookup), only authenticated write
    match /affiliates/{affId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Waitlist: anyone can create/update (unauthenticated signups), public read for admin dashboard
    match /waitlist/{docId} {
      allow create, update: if true;
      allow read: if true;
    }

    // Admin: read-only (no public write)
    match /admin/{docId} {
      allow read: if true;
    }
  }
}
